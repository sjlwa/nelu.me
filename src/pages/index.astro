---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import SectionHeading from '../components/SectionHeading.astro';
import EventsSection from '../components/events/EventsSection';
import SpotifyIframe from '../components/SpotifyIframe.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import Videos from '../components/Videos.astro';
import Contact from '../components/Contact.astro';
---
<Layout>
  <main class="flex flex-col">
    <Hero />

    <About />

    <section id="eventos" class="scroll-mt-16 border-y border-light/10 bg-ink/40">
      <div class="mx-auto w-full max-w-6xl px-5 py-24 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4 flex flex-col gap-4">
          <SectionHeading eyebrow="Eventos" title="Próximas fechas" />
        </div>
        <div class="lg:col-span-8" data-reveal>
          <EventsSection client:only="preact" />
        </div>
      </div>
    </section>

    <section id="musica" class="mx-auto w-full max-w-6xl px-5 py-24 scroll-mt-16 flex flex-col gap-10">
      <SectionHeading eyebrow="Mi música" title="Escúchame" />
      <div data-reveal>
        <SpotifyIframe />
      </div>
    </section>

    <section id="fotos" class="scroll-mt-16 border-y border-light/10 bg-ink/40">
      <div class="mx-auto w-full max-w-6xl px-5 py-24 flex flex-col gap-10">
        <SectionHeading eyebrow="Fotos" title="Mírame de cerca" />
        <PhotoGallery />
      </div>
    </section>

    <section id="videos" class="mx-auto w-full max-w-6xl px-5 py-24 scroll-mt-16 flex flex-col gap-10">
      <SectionHeading eyebrow="Videos" title="Mírame en vivo" />
      <Videos />
    </section>

    <Contact />
  </main>
</Layout>
