---
/**
 * Barra de desplazamiento personalizada: flota sobre el contenido (sin ocupar espacio),
 * usa el color primario y aparece solo mientras se hace scroll o al acercar el cursor.
 */
---
<div id="scrollbar" class="scrollbar" aria-hidden="true">
  <div id="scrollbar-thumb" class="scrollbar-thumb"></div>
</div>

<style>
  .scrollbar {
    position: fixed;
    top: 0.25rem;
    right: 0;
    bottom: 0.25rem;
    width: 1rem;            /* zona amplia para el cursor */
    z-index: 60;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .scrollbar.is-visible {
    opacity: 1;
    pointer-events: auto;
  }
  .scrollbar-thumb {
    position: absolute;
    top: 0;
    right: 0.25rem;
    width: 0.375rem;
    min-height: 1.5rem;
    border-radius: 9999px;
    background: var(--color-primary);
    cursor: grab;
    transition: width 150ms ease;
    will-change: transform;
  }
  .scrollbar:hover .scrollbar-thumb,
  .scrollbar.is-dragging .scrollbar-thumb {
    width: 0.5rem;
  }
  .scrollbar.is-dragging .scrollbar-thumb {
    cursor: grabbing;
  }
  @media (prefers-reduced-motion: reduce) {
    .scrollbar, .scrollbar-thumb { transition: none; }
  }
</style>

<script>
  const track = document.getElementById('scrollbar')!;
  const thumb = document.getElementById('scrollbar-thumb')!;
  const root = document.documentElement;

  let hideTimer: number | undefined;
  let dragging = false;
  let hovering = false;
  let dragStartY = 0;
  let dragStartScroll = 0;

  const metrics = () => {
    const scrollH = root.scrollHeight;
    const viewH = window.innerHeight;
    const trackH = track.clientHeight;
    const thumbH = Math.max(24, Math.round(trackH * viewH / scrollH));
    return { scrollH, viewH, trackH, thumbH, maxScroll: scrollH - viewH, maxThumb: trackH - thumbH };
  };

  const update = () => {
    const m = metrics();
    if (m.maxScroll <= 1) {
      track.classList.remove('is-visible');
      return false;
    }
    const y = m.maxThumb * (window.scrollY / m.maxScroll);
    thumb.style.height = `${m.thumbH}px`;
    thumb.style.transform = `translateY(${y}px)`;
    return true;
  };

  const hide = () => {
    if (dragging || hovering) return;
    track.classList.remove('is-visible');
  };

  const show = (delay = 900) => {
    if (!update()) return;
    track.classList.add('is-visible');
    window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(hide, delay);
  };

  window.addEventListener('scroll', () => show(), { passive: true });
  window.addEventListener('resize', update);
  new ResizeObserver(update).observe(document.body);

  // Mostrar al acercar el cursor al borde derecho.
  window.addEventListener('mousemove', (e) => {
    if (e.clientX > window.innerWidth - 32) show(1500);
  }, { passive: true });

  track.addEventListener('mouseenter', () => { hovering = true; show(); });
  track.addEventListener('mouseleave', () => { hovering = false; show(); });

  // Arrastrar el pulgar.
  thumb.addEventListener('pointerdown', (e) => {
    dragging = true;
    dragStartY = e.clientY;
    dragStartScroll = window.scrollY;
    track.classList.add('is-dragging');
    document.body.classList.add('is-scrollbar-dragging');
    thumb.setPointerCapture(e.pointerId);
    e.preventDefault();
  });

  thumb.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const m = metrics();
    const ratio = m.maxScroll / Math.max(1, m.maxThumb);
    window.scrollTo({ top: dragStartScroll + (e.clientY - dragStartY) * ratio, behavior: 'instant' });
  });

  const endDrag = () => {
    if (!dragging) return;
    dragging = false;
    track.classList.remove('is-dragging');
    document.body.classList.remove('is-scrollbar-dragging');
    show();
  };
  thumb.addEventListener('pointerup', endDrag);
  thumb.addEventListener('pointercancel', endDrag);

  // Clic en la pista: saltar a esa posición.
  track.addEventListener('pointerdown', (e) => {
    if (e.target === thumb) return;
    const m = metrics();
    const rect = track.getBoundingClientRect();
    const y = e.clientY - rect.top - m.thumbH / 2;
    window.scrollTo({ top: (y / Math.max(1, m.maxThumb)) * m.maxScroll, behavior: 'smooth' });
  });

  update();
</script>
