---
import Name from "./../assets/nelu-name.svg?raw";

const links = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#eventos", label: "Eventos" },
  { href: "#musica", label: "Mi música" },
  { href: "#fotos", label: "Fotos" },
  { href: "#videos", label: "Videos" },
  { href: "#contacto", label: "Contacto" },
];
---
<header id="site-nav"
  class="fixed inset-x-0 top-0 z-40 transition-colors duration-300 border-b border-transparent
         data-[scrolled]:bg-dark/80 data-[scrolled]:backdrop-blur-md data-[scrolled]:border-light/10">
  <nav class="mx-auto max-w-6xl px-5 h-16 flex items-center justify-between gap-6" aria-label="Principal">
    <a href="#inicio" class="[&_svg]:h-7 [&_svg]:w-auto [&_svg]:fill-light hover:[&_svg]:fill-primary transition-colors"
       aria-label="Ir al inicio" set:html={Name} />

    <ul class="hidden md:flex items-center gap-1 font-condensed uppercase tracking-[0.18em] text-sm">
      {links.map((l) => (
        <li>
          <a href={l.href} data-nav-link
             class="px-3 py-2 rounded-full text-light/80 hover:text-primary transition-colors
                    data-[active]:text-primary">
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <button id="nav-toggle" class="md:hidden p-2 -mr-2 text-light hover:text-primary"
      aria-expanded="false" aria-controls="nav-mobile" aria-label="Abrir menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path class="icon-open" d="M4 7h16M4 12h16M4 17h16"/>
        <path class="icon-close hidden" d="M6 6l12 12M18 6L6 18"/>
      </svg>
    </button>
  </nav>

  <div id="nav-mobile" class="md:hidden hidden bg-dark/95 backdrop-blur-md border-t border-light/10">
    <ul class="px-5 py-4 flex flex-col font-condensed uppercase tracking-[0.18em]">
      {links.map((l) => (
        <li>
          <a href={l.href} data-nav-link class="block py-3 border-b border-light/10 last:border-0 text-light/90 hover:text-primary data-[active]:text-primary">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const mobile = document.getElementById('nav-mobile')!;
  const iconOpen = toggle.querySelector('.icon-open')!;
  const iconClose = toggle.querySelector('.icon-close')!;
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  // Fondo al hacer scroll
  const onScroll = () => {
    if (window.scrollY > 24) header.dataset.scrolled = '';
    else delete header.dataset.scrolled;
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Menú móvil
  const setOpen = (open: boolean) => {
    mobile.classList.toggle('hidden', !open);
    iconOpen.classList.toggle('hidden', open);
    iconClose.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    if (open) header.dataset.scrolled = '';
  };
  toggle.addEventListener('click', () => setOpen(mobile.classList.contains('hidden')));
  mobile.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  // Resaltar la sección visible
  const sections = Array.from(links)
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!))
    .filter((s): s is HTMLElement => !!s);
  const unique = [...new Set(sections)];

  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter((e) => e.isIntersecting)
      .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
    if (!visible) return;
    const id = `#${visible.target.id}`;
    links.forEach((a) => {
      if (a.getAttribute('href') === id) a.dataset.active = '';
      else delete a.dataset.active;
    });
  }, { rootMargin: '-40% 0px -50% 0px', threshold: [0, 0.25, 0.5] });
  unique.forEach((s) => observer.observe(s));
</script>
