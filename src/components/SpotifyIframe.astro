---
import { tracks } from "../data/tracks";
import MusicPlatformsLinks from "./MusicPlatformsLinks.astro";
---
<div class="card overflow-hidden flex flex-col lg:flex-row">
  <div class="flex-1 flex flex-col">
  <ol class="flex flex-col divide-y divide-light/10">
    {tracks.map((track, i) => (
      <li>
        <button
          type="button"
          class="track group w-full text-start cursor-pointer px-5 py-4 flex items-center gap-4 hover:bg-light/5 transition-colors"
          data-spotify-id={track.uri}>
          <span class="font-condensed text-primary/70 w-6 tabular-nums text-sm">{String(i + 1).padStart(2, '0')}</span>
          <span class={`w-12 h-12 shrink-0 overflow-hidden rounded-lg ${!track.img ? 'bg-clay/60' : ''}`}>
            {track.img && <img class="w-full h-full object-cover" src={track.img} alt="" loading="lazy" />}
          </span>
          <span class="flex flex-col flex-1 min-w-0">
            <span class="font-semibold truncate">{track.title}</span>
            {track.year && <span class="text-sm text-muted">{track.year}</span>}
          </span>
          <span data-play-label class="play-text-init text-xs rounded-full px-2.5 py-1 font-semibold whitespace-nowrap transition-colors">
            Escuchar
          </span>
        </button>
      </li>
    ))}
  </ol>
  <div class="mt-auto px-5 py-5 border-t border-light/10 flex flex-col gap-3">
    <span class="eyebrow">También disponible en</span>
    <MusicPlatformsLinks />
  </div>
  </div>

  <div class="lg:w-[26rem] p-5 bg-ink/40 flex flex-col justify-center gap-3 border-t lg:border-t-0 lg:border-l border-light/10">
    <p class="eyebrow">Reproductor</p>
    <div id="embed-iframe" class="rounded-xl overflow-hidden min-h-[152px]"></div>
    <p class="text-xs text-muted">Reproducción mediante Spotify. Inicia sesión en Spotify para escuchar la canción completa.</p>
  </div>
</div>

<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>
<script src="./spotifyPlayer.ts"></script>
