---
/** Taza de té con vapor animado. Decorativa; respeta prefers-reduced-motion. */
interface Props { class?: string }
const { class: classList = "" } = Astro.props;
---
<svg class={`steam-cup ${classList}`} viewBox="0 0 64 56" width="64" height="56" fill="none" aria-hidden="true">
  <!-- vapor -->
  <g class="steam" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path class="steam-1" d="M22 22c-3-4 3-6 0-10 2-2 4-4 0-8"/>
    <path class="steam-2" d="M32 20c-3-4 3-6 0-10 2-2 4-4 0-8"/>
    <path class="steam-3" d="M42 22c-3-4 3-6 0-10 2-2 4-4 0-8"/>
  </g>
  <!-- taza -->
  <g stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round">
    <path d="M12 28h40v6c0 9-7 16-16 16h-8c-9 0-16-7-16-16v-6Z"/>
    <path d="M52 32h3a5 5 0 0 1 0 10h-4"/>
    <path d="M18 54h28"/>
  </g>
</svg>

<style>
  .steam-cup { color: var(--color-primary); opacity: 0.85; }
  .steam path {
    opacity: 0;
    transform-origin: 50% 100%;
    transform-box: fill-box;
    animation: steam 3.2s ease-in-out infinite;
  }
  .steam-2 { animation-delay: 1.05s !important; }
  .steam-3 { animation-delay: 2.1s !important; }

  @keyframes steam {
    0%   { opacity: 0;   transform: translateY(6px) scaleY(0.6); }
    30%  { opacity: 0.9; }
    70%  { opacity: 0.4; }
    100% { opacity: 0;   transform: translateY(-10px) scaleY(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .steam path { animation: none; opacity: 0.5; transform: none; }
  }
</style>
