---
interface Props {
  name: string;
  url: string;
  svg: string;
  class?: string;
}
const { url, svg, name, class: classList = "" } = Astro.props;
---
<li class={classList}>
  <a href={url} target="_blank" rel="noopener" aria-label={`Escuchar en ${name}`} title={name}
     class="block [&_svg]:fill-light/80 hover:[&_svg]:fill-primary [&_svg]:h-full [&_svg]:w-auto h-7 transition-colors">
    <Fragment set:html={svg} />
  </a>
</li>
