---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { photoAlts, defaultPhotoAlt } from "../data/photos";

/** Carga automáticamente todas las fotos de `src/assets/photos/`. */
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);

const photos = await Promise.all(
  Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const file = path.split("/").pop()!;
      const full = await getImage({ src: mod.default, width: 1800, format: "webp" });
      return { file, src: mod.default, alt: photoAlts[file] ?? defaultPhotoAlt, full: full.src };
    })
);
---
<ul class="columns-1 sm:columns-2 lg:columns-3 gap-4 [&>li]:mb-4" data-reveal>
  {photos.map((p, i) => (
    <li class="break-inside-avoid">
      <button
        type="button"
        class="group relative block w-full overflow-hidden rounded-2xl cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        data-photo-index={i}
        data-full={p.full}
        data-alt={p.alt}
        aria-label={`Ampliar foto ${i + 1}: ${p.alt}`}>
        <Image
          src={p.src}
          alt={p.alt}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        />
        <span class="absolute inset-0 bg-gradient-to-t from-dark/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true"></span>
      </button>
    </li>
  ))}
</ul>

<dialog id="lightbox" class="m-auto bg-transparent p-0 max-w-[95vw] max-h-[95dvh] backdrop:bg-ink/90 backdrop:backdrop-blur-sm">
  <div class="relative flex flex-col items-center gap-3">
    <img id="lightbox-img" class="max-w-[95vw] max-h-[85dvh] object-contain rounded-xl shadow-2xl" alt="" />
    <p id="lightbox-caption" class="text-sm text-light/80 text-center max-w-prose px-4"></p>
    <div class="absolute top-2 right-2 flex gap-2">
      <button id="lightbox-prev" class="button btn-ghost bg-dark/60 !px-3" aria-label="Foto anterior">‹</button>
      <button id="lightbox-next" class="button btn-ghost bg-dark/60 !px-3" aria-label="Foto siguiente">›</button>
      <button id="lightbox-close" class="button btn-ghost bg-dark/60 !px-3" aria-label="Cerrar">✕</button>
    </div>
  </div>
</dialog>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo-index]'));
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption')!;
  let index = 0;

  const show = (i: number) => {
    index = (i + buttons.length) % buttons.length;
    const b = buttons[index];
    img.src = b.dataset.full!;
    img.alt = b.dataset.alt!;
    caption.textContent = b.dataset.alt!;
  };

  buttons.forEach((b) => b.addEventListener('click', () => {
    show(Number(b.dataset.photoIndex));
    dialog.showModal();
  }));

  document.getElementById('lightbox-close')!.addEventListener('click', () => dialog.close());
  document.getElementById('lightbox-prev')!.addEventListener('click', () => show(index - 1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => show(index + 1));

  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
</script>
