---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { photoAlts, defaultPhotoAlt } from "../data/photos";

/** Carga automáticamente todas las fotos de `src/assets/photos/`. */
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/photos/*.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);

const photos = await Promise.all(
  Object.entries(modules)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const file = path.split("/").pop()!;
      const full = await getImage({ src: mod.default, width: 1800, format: "webp" });
      return { file, src: mod.default, alt: photoAlts[file] ?? defaultPhotoAlt, full: full.src };
    })
);
---
<ul class="columns-1 sm:columns-2 lg:columns-3 gap-4 [&>li]:mb-4" data-reveal>
  {photos.map((p, i) => (
    <li class="break-inside-avoid">
      <button
        type="button"
        class="group relative block w-full rounded-2xl [clip-path:inset(0_round_1rem)] cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-primary"
        data-photo-index={i}
        aria-label={`Ampliar foto ${i + 1}: ${p.alt}`}>
        <Image
          src={p.src}
          alt={p.alt}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        />
        <span class="absolute inset-0 bg-gradient-to-t from-dark/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true"></span>
      </button>
    </li>
  ))}
</ul>

<dialog id="lightbox"
  class="fixed inset-0 m-0 h-dvh w-screen max-h-none max-w-none bg-ink/95 p-0 text-light backdrop:bg-transparent"
  aria-label="Galería de fotos">

  <!-- Carrusel deslizable -->
  <div id="lightbox-track"
    class="flex h-full w-full snap-x snap-mandatory overflow-x-auto overflow-y-hidden overscroll-x-contain
           [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {photos.map((p, i) => (
      <figure class="relative flex h-full w-screen shrink-0 snap-center snap-always items-center justify-center m-0 px-3 pt-16 pb-24 sm:px-16">
        <img
          src={p.full}
          alt={p.alt}
          loading="lazy"
          decoding="async"
          data-slide={i}
          class="max-h-full max-w-full object-contain rounded-xl shadow-2xl shadow-black/60 select-none"
          draggable="false"
        />
      </figure>
    ))}
  </div>

  <!-- Controles fijos a la ventana -->
  <div class="pointer-events-none fixed inset-x-0 top-0 flex items-center justify-between p-4">
    <span id="lightbox-counter" class="pointer-events-auto font-condensed tracking-[0.2em] text-sm text-light/70"></span>
    <button id="lightbox-close" class="pointer-events-auto button btn-ghost bg-dark/60 !px-3" aria-label="Cerrar">✕</button>
  </div>

  <button id="lightbox-prev"
    class="pointer-events-auto fixed left-3 top-1/2 -translate-y-1/2 hidden sm:flex h-12 w-12 items-center justify-center rounded-full bg-dark/60 text-light border border-light/20 hover:border-primary hover:text-primary cursor-pointer"
    aria-label="Foto anterior">‹</button>
  <button id="lightbox-next"
    class="pointer-events-auto fixed right-3 top-1/2 -translate-y-1/2 hidden sm:flex h-12 w-12 items-center justify-center rounded-full bg-dark/60 text-light border border-light/20 hover:border-primary hover:text-primary cursor-pointer"
    aria-label="Foto siguiente">›</button>

  <p id="lightbox-caption"
    class="pointer-events-none fixed inset-x-0 bottom-0 p-5 text-center text-sm text-light/80 bg-gradient-to-t from-ink to-transparent"
    aria-live="polite"></p>
</dialog>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-photo-index]'));
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const track = document.getElementById('lightbox-track')!;
  const slides = Array.from(track.querySelectorAll<HTMLImageElement>('[data-slide]'));
  const caption = document.getElementById('lightbox-caption')!;
  const counter = document.getElementById('lightbox-counter')!;
  const total = slides.length;
  let index = 0;

  const updateInfo = (i: number) => {
    index = i;
    caption.textContent = slides[i].alt;
    counter.textContent = `${i + 1} / ${total}`;
  };

  const goTo = (i: number, behavior: ScrollBehavior = 'smooth') => {
    const target = (i + total) % total;
    track.scrollTo({ left: target * track.clientWidth, behavior });
    updateInfo(target);
  };

  const open = (i: number) => {
    dialog.showModal();
    document.body.style.overflow = 'hidden';
    // Esperar al layout del diálogo antes de posicionar el carrusel.
    requestAnimationFrame(() => goTo(i, 'instant'));
  };

  const close = () => {
    dialog.close();
  };

  dialog.addEventListener('close', () => { document.body.style.overflow = ''; });

  buttons.forEach((b) => b.addEventListener('click', () => open(Number(b.dataset.photoIndex))));
  document.getElementById('lightbox-close')!.addEventListener('click', close);
  document.getElementById('lightbox-prev')!.addEventListener('click', () => goTo(index - 1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => goTo(index + 1));

  // Sincronizar índice al deslizar con el dedo o la rueda.
  let scrollTimer: number | undefined;
  track.addEventListener('scroll', () => {
    window.clearTimeout(scrollTimer);
    scrollTimer = window.setTimeout(() => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== index) updateInfo(Math.min(Math.max(i, 0), total - 1));
    }, 80);
  }, { passive: true });

  // Mantener la diapositiva actual al cambiar el tamaño de la ventana.
  window.addEventListener('resize', () => {
    if (dialog.open) goTo(index, 'instant');
  });

  // Cerrar al tocar el fondo (no la imagen).
  track.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName !== 'IMG') close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(index - 1); }
    if (e.key === 'ArrowRight') { e.preventDefault(); goTo(index + 1); }
  });
</script>
